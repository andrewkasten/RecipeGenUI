# Production environment variables for docker-compose.prod.yml (genui / recipes)
#
#   cp .env.prod.example .env.prod
#   # edit .env.prod
#   scp -i ~/.ssh/your-key.pem .env.prod ec2-user@<EIP>:/home/ec2-user/genui/.env
#

# --- Django ---
# Generate a NEW key (do not reuse dev or ImpactDesk's key):
#   openssl rand -base64 50
DJANGO_KEY=replace-me

# Hosts Django will accept requests for.
ALLOWED_HOSTS=recipes.andrewkasten.cv

# Origins trusted for CSRF (must include scheme).
CSRF_TRUSTED_ORIGINS=https://recipes.andrewkasten.cv

# Frontend origin allowed by django-cors-headers.
CORS_ALLOWED_ORIGINS=https://recipes.andrewkasten.cv

# Tells Django to trust X-Forwarded-Proto from nginx so request.is_secure() works.
USE_PROXY_SSL_HEADER=True

# --- Postgres (isolated from ImpactDesk — separate container + volume) ---
# Use a NEW strong password for prod.
POSTGRES_DB=genui
POSTGRES_USER=genui
POSTGRES_PASSWORD=replace-me

# --- AI / image / nutrition APIs ---
GEMINI_API_KEY=replace-me
PIXABAY_API_KEY=replace-me
UNSPLASH_ACCESS_KEY=replace-me
CALORIE_NINJAS_API_KEY=replace-me

# --- Frontend build args (baked into the React bundle at build time) ---
# Full origin so api calls go to https.
VITE_BASE_URL=https://recipes.andrewkasten.cv
